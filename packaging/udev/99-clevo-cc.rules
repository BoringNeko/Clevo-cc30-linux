# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Unprivileged access to the clevo-cc sysfs controls.
#
# The clevod daemon runs as root, so a normal user normally talks to hardware
# through D-Bus + PolicyKit and never needs these permissions. Install this rule
# only when you want to drive the kernel driver's sysfs attributes directly
# (scripts, hwmon tools, or running clevod as the `clevo-cc` group instead of
# root). Writes still go through the EC, so treat membership as privileged.
#
# Grant the group at install time:
#   sudo groupadd -r clevo-cc
#   sudo usermod -aG clevo-cc "$USER"
# The group name is fixed; edit it here and in the installer if you rename it.

# The ACPI platform device is named after its ACPI path (CLV0001:00).
SUBSYSTEM=="platform", KERNEL=="CLV0001:*", ACTION=="add", \
    RUN+="/bin/sh -c 'chgrp clevo-cc /sys%p/fan_mode /sys%p/perf_mode 2>/dev/null; chmod 0660 /sys%p/fan_mode /sys%p/perf_mode 2>/dev/null'"

# hwmon nodes (fan1_input/fan2_input) are read-only; make them group-readable.
SUBSYSTEM=="hwmon", DRIVERS=="clevo-cc", ACTION=="add", \
    RUN+="/bin/sh -c 'chgrp -R clevo-cc /sys%p 2>/dev/null; chmod -R g+r /sys%p 2>/dev/null'"
