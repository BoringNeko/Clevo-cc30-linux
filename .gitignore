# Rust
/target/
**/*.rs.bk
# Applications: keep lockfiles pinned for reproducible builds.
# (library-style crates normally ignore Cargo.lock; this project ships binaries)

# Editor / OS
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.directory

# Local fixtures with machine-identifying data
/fixtures/local/

# Local ACPI verification dump artifacts (contain machine-identifying data)
/acpi-verify/

# Local UI notes, deliberately not published.
/docs/ui.md

# Tauri UI
/ui/node_modules/
/ui/dist/
/ui/src-tauri/target/
/ui/src-tauri/gen/

# Electron UI: electron-builder output (AppImage/deb/rpm/unpacked tree).
/ui/release/

# The UI is an application: keep its lockfile for reproducible builds.
!/ui/src-tauri/Cargo.lock

# Other package managers' lockfiles: this project pins pnpm, and a stray npm or
# yarn tree would be resolved instead on a machine that has one of them.
/ui/package-lock.json
/ui/yarn.lock
/ui/.pnpm-store/

# Distribution build output and the appimagetool blob fetched into packaging/.
/dist/
/packaging/appimage/appimagetool*

# Test / tooling output
/ui/coverage/
/ui/.vitest/
*.tsbuildinfo
.eslintcache

# Python helper scripts (acpidump/iasl parsing, fixture generation)
__pycache__/
*.py[cod]
.venv/

# Editor / OS configuration
.idea/
.vscode/

# Logs and local build noise
*.log
npm-debug.log*
pnpm-debug.log*
