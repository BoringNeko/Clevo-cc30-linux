{
  "name": "clevo-cc-ui",
  "private": true,
  "version": "0.1.3",
  "description": "Clevo control-center desktop UI (React + TypeScript; Tauri 2 or Electron shell)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "electron": "electron .",
    "electron:build": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tauri-apps/api": "^2",
    "colorthief": "^2.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "org.clevo.cc.ui.electron",
    "productName": "Clevo Control Center (Electron)",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "src-tauri/target/electron/release/clevo-cc-ui",
        "to": "clevo-cc-ui"
      },
      {
        "from": "src-tauri/icons/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "System",
      "icon": "src-tauri/icons",
      "executableName": "clevo-cc-ui-electron",
      "desktop": {
        "Name": "Clevo Control Center (Electron)",
        "Comment": "Monitor fans and switch fan/performance modes",
        "Categories": "System;HardwareSettings;Settings;",
        "Keywords": "fan;thermal;performance;clevo;",
        "StartupWMClass": "clevo-cc-ui-electron"
      }
    },
    "appImage": {
      "artifactName": "clevo-cc-ui-electron-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "clevo-cc-linux-ui-electron_${version}_${arch}.deb",
      "depends": ["clevo-cc-linux"]
    },
    "rpm": {
      "artifactName": "clevo-cc-linux-ui-electron-${version}-1.${arch}.rpm",
      "depends": ["clevo-cc-linux"]
    }
  }
}
